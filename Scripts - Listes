-- Gestion de notes
local notes = {5, 7, 8, 10, 12, 15, 20}

-- Calculer une moyenne des notes
local sum = 0
for i = 1, #notes do
	sum += notes[i]
end

print(sum)

local average = sum/#notes
print("La moyenne est de " .. average)

-- Afficher les notes uniquement supérieures à la moyenne
print("Notes supérieures à la moyenne : ")
for i = 1, #notes do
	if notes[i] > average then
		print(notes[i])
	end 
end


